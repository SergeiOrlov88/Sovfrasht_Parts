# ─────────────────────────────────────────────────────────────────────────────
# Совфрахт Детали — пример конфигурации. Скопируйте в .env и задайте значения.
# Реальный .env в Git не попадает (NFR-SEC-05).
# ─────────────────────────────────────────────────────────────────────────────

# ── Общее ────────────────────────────────────────────────────────────────────
APP_ENV=local                      # local | test | prod (NFR-MAINT-03)
DEBUG=true
API_PREFIX=/api/v1

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=sovfrasht
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=sovfrasht_parts
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Порт, на котором БД видна с хост-машины. Нестандартный, чтобы не конфликтовать
# с соседними приложениями на сервере (NFR-DEPLOY-01).
POSTGRES_HOST_PORT=5434

# ── Redis / Celery ───────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_HOST_PORT=6381
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ── API ──────────────────────────────────────────────────────────────────────
API_HOST_PORT=8010

# ── Безопасность и токены (NFR-SEC-02) ───────────────────────────────────────
# ОБЯЗАТЕЛЬНО задать свой длинный случайный ключ. Сгенерировать:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
JWT_ALGORITHM=HS256
# Время жизни токенов, в минутах и днях соответственно.
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=14

# ── CORS (dev-сервер фронтенда) ──────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Пороги бизнес-логики ─────────────────────────────────────────────────────
# Ниже этого значения заявка автоматически не оформляется (FR-REC-04, NFR-ACC-03).
CONFIDENCE_THRESHOLD=70
# Потолок доверия к fallback-ветке: шильдик не прочитан, опознан только тип детали.
VISION_FALLBACK_MAX_CONFIDENCE=55

# ── Хранилище фото: MinIO (NFR-SEC-04) ───────────────────────────────────────
# Логин/пароль MinIO и ключи доступа S3 — одно и то же. Обязательно поменять.
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=change_me_locally
S3_ENDPOINT_URL=http://minio:9000
# Адрес, который подставляется в подписанные ссылки: браузер не знает хост "minio".
S3_PUBLIC_ENDPOINT_URL=http://localhost:9010
S3_BUCKET=scans
S3_REGION=us-east-1
S3_PRESIGN_TTL_SECONDS=900
MINIO_HOST_PORT=9010
MINIO_CONSOLE_PORT=9011

# ── Загрузка фото ────────────────────────────────────────────────────────────
MAX_PHOTOS_PER_SCAN=3
MAX_PHOTO_SIZE_MB=12
ALLOWED_PHOTO_MIME=image/jpeg,image/png,image/heic,image/heif,image/webp

# ── Распознавание: провайдеры за адаптером (docs/06) ─────────────────────────
# OCR_PROVIDER: yandex | stub      VISION_PROVIDER: openrouter | llm | stub
# stub = провайдер выключен: конвейер не падает, но и не распознаёт.
OCR_PROVIDER=yandex
VISION_PROVIDER=openrouter

# RECOGNITION_MODE: vision_first | ocr_first
#   vision_first — ОСНОВНОЙ путь: сильная vision-модель определяет деталь всегда,
#                  каталог становится обогащением. Позиции нет в каталоге — ответ
#                  всё равно содержательный, а не «не найдено».
#   ocr_first    — прежний путь: сначала OCR шильдика, vision только как fallback.
#                  Оставлен для отката: меняется одной переменной, без правок кода.
RECOGNITION_MODE=vision_first
# Потолок доверия к основному vision-пути (fallback-потолок задаётся отдельно выше)
VISION_PRIMARY_MAX_CONFIDENCE=90

# Yandex Vision OCR — основной путь. Ключ выдаётся сервисному аккаунту.
YANDEX_OCR_URL=https://ocr.api.cloud.yandex.net/ocr/v1/recognizeText
YANDEX_API_KEY=
YANDEX_FOLDER_ID=

# Облачная vision-модель — fallback, когда шильдик не читается.
# Ожидается OpenAI-совместимый /chat/completions с поддержкой изображений.
VISION_LLM_URL=
VISION_LLM_API_KEY=
VISION_LLM_MODEL=

# OpenRouter — один ключ на все фронтир-модели зрения (VISION_PROVIDER=openrouter).
# Ключ НИКОГДА не коммитим: .env и .env.* уже в .gitignore (NFR-SEC-05).
OPENROUTER_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_API_KEY=
# Примеры: openai/gpt-4o | anthropic/claude-sonnet-4 | google/gemini-2.5-pro
OPENROUTER_MODEL=openai/gpt-4o
OPENROUTER_MAX_TOKENS=700
# OpenRouter просит идентифицировать приложение — влияет на лимиты и статистику
OPENROUTER_REFERER=
OPENROUTER_TITLE=Sovfrasht Parts

# ── Надёжность внешних вызовов (NFR-REL-03) ──────────────────────────────────
EXTERNAL_TIMEOUT_SECONDS=20
EXTERNAL_MAX_ATTEMPTS=3
EXTERNAL_BACKOFF_SECONDS=1.5

# ── Контроль стоимости распознавания (NFR-COST-01) ───────────────────────────
VISION_CACHE_ENABLED=true
VISION_CACHE_TTL_DAYS=30
MAX_IMAGE_SIDE_PX=2000
